{
  "name": "gpr-slp-invite",
  "version": "1.4.6",
  "private": true,
  "description": "GPR Sportradio SLP Invite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "nl.gprsportradio.slp-invite",
    "productName": "GPR SLP Invite",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gpr-slp-updater.just-produced.nl/slp-invite/"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "playwright-core": "^1.56.0"
  }
}
