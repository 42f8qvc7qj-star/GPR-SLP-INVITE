{
  "name": "gpr-slp-invite",
  "version": "1.3.0",
  "private": true,
  "description": "GPR Sportradio SLP Invite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "nl.gprsportradio.slp-invite",
    "productName": "GPR SLP Invite",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.invalid/slp-invite/"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
